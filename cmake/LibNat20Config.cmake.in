@PACKAGE_INIT@

# If BoringSSL support was built, consuming projects need to provide the crypto target.
# This can be done by ensuring BoringSSL is available before find_package(LibNat20).
# If using FetchContent for BoringSSL, make sure it's populated before finding LibNat20.
if(@LIBNAT20_NEEDS_BORINGSSL@)
    # Check if the crypto target already exists (user provided it)
    if(NOT TARGET crypto)
        # Attempt to fetch BoringSSL if not already available
        include(FetchContent)
        FetchContent_Declare(
            crypto
            GIT_REPOSITORY https://boringssl.googlesource.com/boringssl
            GIT_TAG        dc65229e58a98c0768d017d0c9bbe376f20c2577
            FIND_PACKAGE_ARGS  # Try find_package first if available
        )
        FetchContent_MakeAvailable(crypto)

        if(NOT TARGET crypto)
            set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
                "LibNat20 was built with BoringSSL support, but the crypto target is not available. "
                "Please ensure BoringSSL is available before calling find_package(LibNat20).")
            set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
            return()
        endif()
    endif()
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/LibNat20Targets.cmake")

# Set variables for compatibility
set(LIBNAT20_LIBRARIES LibNat20::nat20)
set(LIBNAT20_INCLUDE_DIRS "${_IMPORT_PREFIX}/include")
set(LIBNAT20_FOUND TRUE)

# Check that all required components are available
check_required_components(LibNat20)
