[
  {
    "include": [
      "**/*.yml",
      "**/CMakeLists.txt",
      "**/*.cmake.in",
      "**/*.mk",
      "**/*.sh",
      "**/Config.in",
      "**/Kbuild",
      "examples/linux/br_external/external.desc",
      "examples/linux/**/Makefile",
      ".clang-format",
      ".gitignore"
    ],
    "license": "./.github/license-check/header-apache2-or-gpl2-hashtag.txt"
  },
  {
    "include": [
      "**/*.c",
      "**/*.h",
      "**/*.cpp"
    ],
    "license": "./.github/license-check/header-apache2-or-gpl2-slash-star.txt"
  },
  {
    "include": [
      "**/*.cddl"
    ],
    "license": "./.github/license-check/header-apache2-or-gpl2-semicolon.txt"
  },
  {
    "include": [
      "**/*.md",
      "**/*.txt",
      "examples/linux/br_external/configs/*"
    ],
    "exclude": [
      "**/CMakeLists.txt"
    ]
  }
]
